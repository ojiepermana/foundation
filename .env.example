# Credential role backend development dengan privilege minimum, bukan migrator.
DATABASE_URL=
NODE_ENV=development
# Tambahkan URL role worker sesuai registry ketika worker diperlukan.
# Origin publik backend (spec 0014). Opsional di development: tanpa nilai, origin yang diizinkan http://127.0.0.1:8889
# dan http://localhost:8889. Wajib origin https tanpa path di production.
# PUBLIC_ORIGIN=
