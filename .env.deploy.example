# Khusus topologi rujukan deploy/compose.yaml (spec 0012); salin ke .env.deploy, beri mode 0600, lalu isi nilainya.
# Berikan file ini secara eksplisit: docker compose --env-file .env.deploy -f deploy/compose.yaml ...
# File asli diabaikan Git melalui pola .env.*. Jangan menyimpan nilai secret di file contoh ini.

# Wajib. Tag image hasil build lokal dari root monorepo.
FOUNDATION_FRONTEND_IMAGE=
FOUNDATION_BACKEND_IMAGE=
FOUNDATION_MIGRATE_IMAGE=

# Wajib, bukan secret. Origin publik edge persis seperti dibuka browser: skema https:, tanpa path, query, atau garis
# miring akhir, misalnya https://app.example.com. Menjadi PUBLIC_ORIGIN backend (spec 0014).
FOUNDATION_PUBLIC_ORIGIN=

# Aturan nilai secret (docs/rules/deployment.md, bagian Topologi):
# - Compose mengganti $ di file ini: ab$cd1234 menjadi ab, dan ${HOME} menjadi path host. Pakai password huruf dan
#   angka saja (misalnya openssl rand -hex 24), atau tulis setiap $ sebagai $$.
# - Bentuk DSN: postgres://<role>:<password>@postgres:5432/foundation. Karakter khusus pada password ditulis dengan persen
#   encoding (@ %40, : %3A, / %2F, # %23, ? %3F, % %25).
# - Peringatan Compose "variable is not set" berarti nilai terpotong; perbaiki file ini sebelum melanjutkan.
# - File ini memuat password admin bersama DSN runtime: perlakukan sebagai secret setingkat admin, jangan ikutkan ke
#   backup biasa, bundel dukungan, atau ekspor secret CI.

# Wajib, secret. Password foundation_admin, hanya dipakai saat cluster pertama kali dibuat.
FOUNDATION_POSTGRES_PASSWORD=
# Wajib, secret. DSN role foundation_backend ke postgres:5432/foundation; menjadi DATABASE_URL backend.
FOUNDATION_BACKEND_DATABASE_URL=
# Wajib, secret. DSN role foundation_migrator; hanya untuk service migrate.
FOUNDATION_MIGRATOR_DATABASE_URL=

# Wajib, secret file. Path host absolut sertifikat (rantai lengkap) dan key TLS edge, disimpan di luar checkout (misalnya
# /etc/foundation/tls/); key harus dapat dibaca UID 101.
FOUNDATION_EDGE_TLS_CERT_FILE=
FOUNDATION_EDGE_TLS_KEY_FILE=

# Opsional. Hapus tanda pagar untuk mengganti nilai default.
# FOUNDATION_POSTGRES_IMAGE=foundation-postgres:18-pinned
# FOUNDATION_EDGE_BIND=0.0.0.0
# FOUNDATION_EDGE_HTTPS_PORT=443
# FOUNDATION_EDGE_HTTP_PORT=80

# FOUNDATION_ADMIN_DATABASE_URL, FOUNDATION_MIGRATOR_PASSWORD, dan FOUNDATION_BACKEND_PASSWORD hanya ada di shell
# operator untuk run provisioning, diteruskan dengan -e <NAMA>, dan tidak ditulis ke file ini.
