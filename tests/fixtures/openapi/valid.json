        "type": "object"
      },
      "ReadinessAvailable": {
        "$id": "#/components/schemas/ReadinessAvailable",
        "additionalProperties": false,
        "properties": {
          "appliedMigrations": {
            "minimum": 0,
            "type": "integer"
          },
          "checkedAt": {
            "format": "date-time",
            "type": "string"
          },
          "status": {
            "const": "available",
            "enum": [
              "available"
            ],
            "type": "string"
          }
        },
        "required": [
          "status",
          "checkedAt",
          "appliedMigrations"
        ],
        "type": "object"
      },
