{
  "components": {
    "schemas": {
      "AuthError": {
        "$id": "#/components/schemas/AuthError",
        "additionalProperties": false,
        "properties": {
          "error": {
            "enum": [
              "Invalid request",
              "Invalid credentials",
              "Unauthorized",
              "Forbidden",
              "Not found",
              "Unsupported media type",
              "Too many requests",
              "Service unavailable",
              "Internal server error"
            ],
            "type": "string"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "AuthSession": {
        "$id": "#/components/schemas/AuthSession",
        "additionalProperties": false,
        "properties": {
          "csrfToken": {
            "maxLength": 43,
            "minLength": 43,
            "pattern": "^[A-Za-z0-9_-]{43}$",
            "type": "string"
          },
          "session": {
            "additionalProperties": false,
            "properties": {
              "createdAt": {
                "format": "date-time",
                "type": "string"
              },
              "expiresAt": {
                "format": "date-time",
                "type": "string"
              },
              "id": {
                "format": "uuid",
                "type": "string"
              },
              "idleExpiresAt": {
                "format": "date-time",
                "type": "string"
              },
              "lastSeenAt": {
                "format": "date-time",
                "type": "string"
              }
            },
            "required": [
              "id",
              "createdAt",
              "lastSeenAt",
              "idleExpiresAt",
              "expiresAt"
            ],
            "type": "object"
          },
          "user": {
            "additionalProperties": false,
            "properties": {
              "displayName": {
                "type": "string"
              },
              "email": {
                "type": "string"
              },
              "id": {
                "format": "uuid",
                "type": "string"
              }
            },
            "required": [
              "id",
              "email",
              "displayName"
            ],
            "type": "object"
          }
        },
        "required": [
          "user",
          "session",
          "csrfToken"
        ],
        "type": "object"
      },
      "AuthSessionList": {
        "$id": "#/components/schemas/AuthSessionList",
        "additionalProperties": false,
        "properties": {
          "sessions": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "createdAt": {
                  "format": "date-time",
                  "type": "string"
                },
                "current": {
                  "type": "boolean"
                },
                "id": {
                  "format": "uuid",
                  "type": "string"
                },
                "lastSeenAt": {
                  "format": "date-time",
                  "type": "string"
                }
              },
              "required": [
                "id",
                "createdAt",
                "lastSeenAt",
                "current"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "sessions"
        ],
        "type": "object"
      },
      "DevelopmentStatus": {
        "$id": "#/components/schemas/DevelopmentStatus",
        "additionalProperties": false,
        "properties": {
          "status": {
            "const": "ok",
