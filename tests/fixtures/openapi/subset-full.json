    "/api/auth/sessions": {
      "get": {
        "operationId": "listAuthSessions",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthSessionList"
                }
              }
            },
            "description": "Response for status 200"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthError"
                }
              }
            },
