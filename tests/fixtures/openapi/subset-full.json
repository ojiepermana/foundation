{
  "components": {
    "schemas": {
      "CatalogItem": {
        "$id": "#/components/schemas/CatalogItem",
        "additionalProperties": false,
        "description": "One item in the catalog",
        "properties": {
          "accessCode": {
            "type": "string",
            "writeOnly": true
          },
          "active": {
            "default": true,
            "type": "boolean"
          },
          "currency": {
            "const": "IDR",
            "enum": [
              "IDR"
            ],
            "type": "string"
          },
          "dimensions": {
            "additionalProperties": false,
            "properties": {
              "height": {
                "type": "number"
              },
              "width": {
                "type": "number"
              }
            },
            "required": [
              "width"
            ],
            "type": "object"
          },
          "id": {
            "format": "uuid",
            "readOnly": true,
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/ItemKind"
          },
          "labels": {
            "items": {
              "maxLength": 20,
              "type": "string"
            },
            "type": "array"
          },
          "legacyCode": {
            "deprecated": true,
            "description": "Old code",
            "type": "string"
          },
          "name": {
            "example": "Desk lamp",
            "examples": [
              "Desk lamp",
              "Chair"
            ],
            "maxLength": 80,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9 ]+$",
            "type": "string"
          },
          "priority": {
            "default": 3,
            "maximum": 5,
            "minimum": 1,
            "type": "integer"
          },
          "priorityLevel": {
            "$ref": "#/components/schemas/ItemPriority"
          },
          "ratio": {
            "const": 0.5,
            "enum": [
              0.5
            ],
            "type": "number"
          },
          "related": {
            "items": {
              "$ref": "#/components/schemas/ItemKind"
            },
            "type": "array"
          },
          "schemaVersion": {
            "const": 1,
            "type": "integer"
          },
          "status": {
            "enum": [
              "draft",
              "published"
            ],
            "title": "Status",
            "type": "string"
          },
          "weight": {
            "example": 2.5,
            "maximum": 1000.5,
            "minimum": 0,
            "type": "number"
          },
          "weightClass": {
            "$ref": "#/components/schemas/ItemWeightClass"
          }
        },
        "required": [
          "id",
          "name",
          "kind",
          "priority",
          "weight",
          "active",
          "currency",
          "labels",
          "related"
        ],
        "title": "Catalog item",
        "type": "object"
      },
      "CatalogItemInput": {
        "$id": "#/components/schemas/CatalogItemInput",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "$ref": "#/components/schemas/ItemKind"
          },
          "labels": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "weight": {
            "type": "number"
          }
        },
        "required": [
          "name",
          "kind"
        ],
        "type": "object"
      },
      "CatalogItemList": {
        "$id": "#/components/schemas/CatalogItemList",
        "items": {
          "$ref": "#/components/schemas/CatalogItem"
        },
        "type": "array"
      },
      "CatalogItemPatch": {
        "additionalProperties": false,
        "properties": {
          "active": {
            "type": "boolean"
          },
          "name": {
            "type": "string"
          },
          "priorityLevel": {
            "$ref": "#/components/schemas/ItemPriority"
          }
        },
        "type": "object"
      },
      "DevelopmentStatus": {
        "$id": "#/components/schemas/DevelopmentStatus",
        "additionalProperties": false,
        "properties": {
          "status": {
            "const": "ok",
            "enum": [
              "ok"
            ],
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "ItemKind": {
        "description": "Kind of item",
        "enum": [
          "tool",
          "part"
        ],
        "type": "string"
      },
      "ItemPriority": {
        "enum": [
          1,
          2,
          3
        ],
        "type": "integer"
      },
      "ItemWeightClass": {
        "enum": [
          0.5,
          1,
          2.5
        ],
        "type": "number"
      }
    },
    "securitySchemes": {
      "Bearer": {
        "bearerFormat": "JWT",
        "description": "Access token",
        "scheme": "bearer",
        "type": "http"
      },
      "HeaderKey": {
        "in": "header",
        "name": "X-Api-Key",
        "type": "apiKey"
      },
      "QueryKey": {
        "description": "Key in the query string",
        "in": "query",
        "name": "api_key",
        "type": "apiKey"
      },
      "SessionCookie": {
        "in": "cookie",
        "name": "session",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "Every shape the checker accepts and the SDK generator reads (spec 0008, AC-7)",
    "title": "Foundation contract subset",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/catalog/items": {
      "get": {
        "operationId": "listCatalogItems",
        "parameters": [
          {
            "description": "Text search",
            "in": "query",
            "name": "search",
            "schema": {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 20,
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "minWeight",
            "schema": {
              "minimum": 0,
              "type": "number"
            }
          },
          {
            "in": "query",
            "name": "includeArchived",
            "schema": {
              "default": false,
              "type": "boolean"
            }
          },
          {
            "in": "query",
            "name": "sort",
            "schema": {
              "enum": [
                "name",
                "weight"
              ],
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "X-Request-Id",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogItemList"
                }
              }
            },
            "description": "Items"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Invalid query"
          }
        },
        "security": [],
        "summary": "List catalog items",
        "tags": [
          "catalog-items"
        ]
      },
      "options": {
        "operationId": "optionsCatalogItems",
        "responses": {
          "204": {
            "description": "Allowed methods"
          }
        },
        "security": [],
        "tags": [
          "catalog-items"
        ]
      },
      "post": {
        "description": "Create an item",
        "operationId": "createCatalogItem",
        "parameters": [
          {
            "in": "header",
            "name": "X-Idempotency-Key",
            "required": true,
            "schema": {
              "minLength": 8,
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CatalogItemInput"
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/CatalogItemInput"
              }
            },
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/CatalogItemInput"
              }
            }
          },
          "description": "New item",
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogItem"
                }
              }
            },
            "description": "Created"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Invalid item"
          }
        },
        "security": [
          {
            "Bearer": []
          }
        ],
        "tags": [
          "catalog-items"
        ]
      }
    },
    "/api/catalog/items/{itemId}": {
      "delete": {
        "operationId": "deleteCatalogItem",
        "parameters": [
          {
            "description": "Item identifier",
            "in": "path",
            "name": "itemId",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Missing item"
          }
        },
        "security": [
          {
            "SessionCookie": []
          }
        ],
        "tags": [
          "catalog-items"
        ]
      },
      "head": {
        "operationId": "checkCatalogItem",
        "parameters": [
          {
            "description": "Item identifier",
            "in": "path",
            "name": "itemId",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Exists"
          },
          "404": {
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Missing item"
          }
        },
        "security": [
          {
            "Bearer": []
          },
          {
            "SessionCookie": []
          }
        ],
        "tags": [
          "catalog-items"
        ]
      },
      "patch": {
        "operationId": "updateCatalogItem",
        "parameters": [
          {
            "description": "Item identifier",
            "in": "path",
            "name": "itemId",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CatalogItemPatch"
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/CatalogItemPatch"
              }
            },
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/CatalogItemPatch"
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogItem"
                }
              }
            },
            "description": "Updated"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Missing item"
          }
        },
        "security": [
          {
            "QueryKey": []
          }
        ],
        "tags": [
          "catalog-items"
        ]
      },
      "put": {
        "operationId": "replaceCatalogItem",
        "parameters": [
          {
            "description": "Item identifier",
            "in": "path",
            "name": "itemId",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CatalogItemInput"
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/CatalogItemInput"
              }
            },
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/CatalogItemInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogItem"
                }
              }
            },
            "description": "Replaced"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Missing item"
          }
        },
        "security": [
          {
            "HeaderKey": []
          }
        ],
        "tags": [
          "catalog-items"
        ]
      }
    },
    "/api/catalog/items/{itemId}/versions/{version}/scale/{scale}/visible/{visible}": {
      "get": {
        "operationId": "getCatalogItemView",
        "parameters": [
          {
            "description": "Item identifier",
            "in": "path",
            "name": "itemId",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "version",
            "required": true,
            "schema": {
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "in": "path",
            "name": "scale",
            "required": true,
            "schema": {
              "maximum": 10,
              "minimum": 0.1,
              "type": "number"
            }
          },
          {
            "in": "path",
            "name": "visible",
            "required": true,
            "schema": {
              "type": "boolean"
            }
          },
          {
            "in": "header",
            "name": "X-Trace-Label",
            "schema": {
              "pattern": "^[a-z-]+$",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "X-Retry-Count",
            "schema": {
              "maximum": 3,
              "minimum": 0,
              "type": "integer"
            }
          },
          {
            "in": "header",
            "name": "X-Client-Weight",
            "schema": {
              "type": "number"
            }
          },
          {
            "in": "header",
            "name": "X-Dry-Run",
            "required": true,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogItem"
                }
              }
            },
            "description": "Item view"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Missing item"
          }
        },
        "security": [
          {
            "Bearer": [],
            "HeaderKey": []
          }
        ],
        "tags": [
          "catalog-items"
        ]
      }
    },
    "/api/catalog/legacy-items": {
      "get": {
        "deprecated": true,
        "operationId": "listLegacyCatalogItems",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogItemList"
                }
              }
            },
            "description": "Items"
          }
        },
        "security": [],
        "summary": "Old listing",
        "tags": [
          "catalog-items"
        ]
      }
    },
    "/api/status": {
      "get": {
        "operationId": "getDevelopmentStatus",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DevelopmentStatus"
                }
              }
            },
            "description": "Response for status 200"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "error": {
                      "const": "Internal server error",
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Response for status 500"
          }
        },
        "security": [],
        "summary": "Development process status",
        "tags": [
          "development"
        ]
      }
    }
  },
  "security": [],
  "tags": [
    {
      "description": "Catalog items",
      "name": "catalog-items"
    },
    {
      "name": "development"
    }
  ]
}
