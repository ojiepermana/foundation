{
  "components": {
    "schemas": {
      "AuthError": {
        "$id": "#/components/schemas/AuthError",
        "additionalProperties": false,
        "properties": {
          "error": {
            "enum": [
              "Invalid request",
              "Invalid credentials",
              "Unauthorized",
              "Forbidden",
              "Not found",
              "Unsupported media type",
              "Too many requests",
              "Service unavailable",
              "Internal server error"
            ],
            "type": "string"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "AuthSession": {
        "$id": "#/components/schemas/AuthSession",
        "additionalProperties": false,
        "properties": {
          "csrfToken": {
            "maxLength": 43,
            "minLength": 43,
            "pattern": "^[A-Za-z0-9_-]{43}$",
            "type": "string"
          },
          "session": {
            "additionalProperties": false,
            "properties": {
              "createdAt": {
                "format": "date-time",
                "type": "string"
              },
              "expiresAt": {
                "format": "date-time",
                "type": "string"
              },
              "id": {
                "format": "uuid",
                "type": "string"
              },
              "idleExpiresAt": {
                "format": "date-time",
                "type": "string"
              },
              "lastSeenAt": {
                "format": "date-time",
                "type": "string"
              }
            },
            "required": [
              "id",
              "createdAt",
              "lastSeenAt",
              "idleExpiresAt",
              "expiresAt"
            ],
            "type": "object"
          },
          "user": {
            "additionalProperties": false,
            "properties": {
              "displayName": {
                "type": "string"
              },
              "email": {
                "type": "string"
              },
              "id": {
                "format": "uuid",
                "type": "string"
              }
            },
            "required": [
              "id",
              "email",
              "displayName"
            ],
            "type": "object"
          }
        },
        "required": [
          "user",
          "session",
          "csrfToken"
        ],
        "type": "object"
      },
      "AuthSessionList": {
        "$id": "#/components/schemas/AuthSessionList",
        "additionalProperties": false,
        "properties": {
          "sessions": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "createdAt": {
                  "format": "date-time",
                  "type": "string"
                },
                "current": {
                  "type": "boolean"
                },
                "id": {
                  "format": "uuid",
                  "type": "string"
                },
                "lastSeenAt": {
                  "format": "date-time",
                  "type": "string"
                }
              },
              "required": [
                "id",
                "createdAt",
                "lastSeenAt",
                "current"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "sessions"
        ],
        "type": "object"
      },
      "CatalogItem": {
        "$id": "#/components/schemas/CatalogItem",
        "additionalProperties": false,
        "description": "One item in the catalog",
        "properties": {
          "accessCode": {
            "type": "string",
            "writeOnly": true
          },
          "active": {
            "default": true,
            "type": "boolean"
          },
          "currency": {
            "const": "IDR",
            "enum": [
              "IDR"
            ],
            "type": "string"
          },
          "dimensions": {
            "additionalProperties": false,
            "properties": {
              "height": {
                "type": "number"
              },
              "width": {
                "type": "number"
              }
            },
            "required": [
              "width"
            ],
            "type": "object"
          },
          "id": {
            "format": "uuid",
            "readOnly": true,
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/ItemKind"
          },
          "labels": {
            "items": {
              "maxLength": 20,
              "type": "string"
            },
            "type": "array"
          },
          "legacyCode": {
            "deprecated": true,
            "description": "Old code",
            "type": "string"
          },
          "name": {
            "example": "Desk lamp",
            "examples": [
              "Desk lamp",
              "Chair"
            ],
            "maxLength": 80,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9 ]+$",
            "type": "string"
          },
          "priority": {
            "default": 3,
            "maximum": 5,
            "minimum": 1,
            "type": "integer"
          },
          "priorityLevel": {
            "$ref": "#/components/schemas/ItemPriority"
          },
          "ratio": {
            "const": 0.5,
            "enum": [
              0.5
            ],
            "type": "number"
          },
          "related": {
            "items": {
              "$ref": "#/components/schemas/ItemKind"
            },
            "type": "array"
          },
          "schemaVersion": {
            "const": 1,
            "type": "integer"
          },
          "status": {
            "enum": [
              "draft",
              "published"
            ],
            "title": "Status",
            "type": "string"
          },
          "weight": {
            "example": 2.5,
            "maximum": 1000.5,
            "minimum": 0,
            "type": "number"
          },
          "weightClass": {
            "$ref": "#/components/schemas/ItemWeightClass"
          }
        },
        "required": [
          "id",
          "name",
          "kind",
          "priority",
          "weight",
          "active",
          "currency",
          "labels",
          "related"
        ],
        "title": "Catalog item",
        "type": "object"
      },
      "CatalogItemInput": {
        "$id": "#/components/schemas/CatalogItemInput",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "$ref": "#/components/schemas/ItemKind"
          },
          "labels": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "weight": {
            "type": "number"
          }
        },
        "required": [
          "name",
          "kind"
        ],
        "type": "object"
      },
      "CatalogItemList": {
        "$id": "#/components/schemas/CatalogItemList",
        "items": {
          "$ref": "#/components/schemas/CatalogItem"
        },
        "type": "array"
      },
      "CatalogItemPatch": {
        "additionalProperties": false,
        "properties": {
          "active": {
            "type": "boolean"
          },
          "name": {
            "type": "string"
          },
          "priorityLevel": {
            "$ref": "#/components/schemas/ItemPriority"
          }
        },
        "type": "object"
      },
      "DevelopmentStatus": {
        "$id": "#/components/schemas/DevelopmentStatus",
        "additionalProperties": false,
        "properties": {
          "status": {
            "const": "ok",
            "enum": [
              "ok"
            ],
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "HealthLive": {
        "$id": "#/components/schemas/HealthLive",
        "additionalProperties": false,
        "properties": {
          "status": {
            "const": "live",
            "enum": [
              "live"
            ],
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "HealthReady": {
        "$id": "#/components/schemas/HealthReady",
        "additionalProperties": false,
        "properties": {
          "status": {
            "const": "ready",
            "enum": [
              "ready"
            ],
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "HealthUnavailable": {
        "$id": "#/components/schemas/HealthUnavailable",
        "additionalProperties": false,
        "properties": {
          "status": {
            "const": "unavailable",
            "enum": [
              "unavailable"
            ],
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "ItemKind": {
        "description": "Kind of item",
        "enum": [
          "tool",
          "part"
        ],
        "type": "string"
      },
      "ItemPriority": {
        "enum": [
          1,
          2,
          3
        ],
        "type": "integer"
      },
      "ItemWeightClass": {
        "enum": [
          0.5,
          1,
          2.5
        ],
        "type": "number"
      },
      "ReadinessAvailable": {
        "$id": "#/components/schemas/ReadinessAvailable",
        "additionalProperties": false,
        "properties": {
          "appliedMigrations": {
            "minimum": 0,
            "type": "integer"
          },
          "checkedAt": {
            "format": "date-time",
            "type": "string"
          },
          "status": {
            "const": "available",
            "enum": [
              "available"
            ],
            "type": "string"
          }
        },
        "required": [
          "status",
          "checkedAt",
          "appliedMigrations"
        ],
        "type": "object"
      },
      "ReadinessBusy": {
        "$id": "#/components/schemas/ReadinessBusy",
        "additionalProperties": false,
        "properties": {
          "status": {
            "const": "busy",
            "enum": [
              "busy"
            ],
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "ReadinessUnavailable": {
        "$id": "#/components/schemas/ReadinessUnavailable",
        "additionalProperties": false,
        "properties": {
          "checkedAt": {
            "format": "date-time",
            "type": "string"
          },
          "status": {
            "const": "unavailable",
            "enum": [
              "unavailable"
            ],
            "type": "string"
          }
        },
        "required": [
          "status",
          "checkedAt"
        ],
        "type": "object"
      },
      "SignInRequest": {
        "$id": "#/components/schemas/SignInRequest",
        "additionalProperties": false,
        "properties": {
          "email": {
            "maxLength": 254,
            "minLength": 3,
            "type": "string"
          },
          "password": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "Bearer": {
        "bearerFormat": "JWT",
        "description": "Access token",
        "scheme": "bearer",
        "type": "http"
      },
      "HeaderKey": {
        "in": "header",
        "name": "X-Api-Key",
        "type": "apiKey"
      },
      "QueryKey": {
        "description": "Key in the query string",
        "in": "query",
        "name": "api_key",
        "type": "apiKey"
      },
      "SessionCookie": {
        "in": "cookie",
        "name": "session",
        "type": "apiKey"
      },
      "sessionCookie": {
        "description": "Cookie sesi HttpOnly. Komposisi development memakai nama foundation_session tanpa Secure karena berjalan di HTTP lokal.",
        "in": "cookie",
        "name": "__Host-foundation_session",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "Every shape the checker accepts and the SDK generator reads (spec 0008, AC-7)",
    "title": "Foundation contract subset",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
