    "/api/catalog/items": {
      "get": {
        "operationId": "listCatalogItems",
        "parameters": [
          {
            "description": "Text search",
            "in": "query",
            "name": "search",
            "schema": {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 20,
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "minWeight",
            "schema": {
              "minimum": 0,
              "type": "number"
            }
          },
          {
            "in": "query",
            "name": "includeArchived",
            "schema": {
              "default": false,
              "type": "boolean"
            }
          },
          {
            "in": "query",
            "name": "sort",
            "schema": {
              "enum": [
                "name",
                "weight"
              ],
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "X-Request-Id",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogItemList"
                }
              }
            },
            "description": "Items"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Invalid query"
          }
        },
        "security": [],
        "summary": "List catalog items",
        "tags": [
          "catalog-items"
        ]
      },
      "options": {
        "operationId": "optionsCatalogItems",
        "responses": {
          "204": {
            "description": "Allowed methods"
          }
        },
        "security": [],
        "tags": [
          "catalog-items"
        ]
      },
      "post": {
        "description": "Create an item",
        "operationId": "createCatalogItem",
        "parameters": [
          {
            "in": "header",
            "name": "X-Idempotency-Key",
            "required": true,
            "schema": {
              "minLength": 8,
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CatalogItemInput"
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/CatalogItemInput"
              }
            },
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/CatalogItemInput"
              }
            }
          },
          "description": "New item",
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogItem"
                }
              }
            },
            "description": "Created"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Invalid item"
          }
        },
        "security": [
          {
            "Bearer": []
          }
        ],
        "tags": [
          "catalog-items"
        ]
      }
    },
    "/api/catalog/items/{itemId}": {
      "delete": {
        "operationId": "deleteCatalogItem",
        "parameters": [
          {
            "description": "Item identifier",
            "in": "path",
            "name": "itemId",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Missing item"
          }
        },
        "security": [
          {
            "SessionCookie": []
          }
        ],
        "tags": [
          "catalog-items"
        ]
      },
      "head": {
        "operationId": "checkCatalogItem",
        "parameters": [
          {
            "description": "Item identifier",
            "in": "path",
            "name": "itemId",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Exists"
          },
          "404": {
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Missing item"
          }
        },
        "security": [
          {
            "Bearer": []
          },
          {
            "SessionCookie": []
          }
        ],
        "tags": [
          "catalog-items"
        ]
      },
      "patch": {
        "operationId": "updateCatalogItem",
        "parameters": [
          {
            "description": "Item identifier",
            "in": "path",
            "name": "itemId",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CatalogItemPatch"
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/CatalogItemPatch"
              }
            },
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/CatalogItemPatch"
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogItem"
                }
              }
            },
            "description": "Updated"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Missing item"
          }
        },
        "security": [
          {
            "QueryKey": []
          }
        ],
        "tags": [
          "catalog-items"
        ]
      },
      "put": {
        "operationId": "replaceCatalogItem",
        "parameters": [
          {
            "description": "Item identifier",
            "in": "path",
