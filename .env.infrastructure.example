# Khusus Compose; salin ke .env.infrastructure lalu isi password lokal.
# Berikan file ini secara eksplisit: docker compose --env-file .env.infrastructure ...
# Credential ini milik administrator provisioning (foundation_admin), bukan role runtime.
# Jangan salin nilai ini ke .env aplikasi atau DATABASE_URL backend maupun worker.

# Wajib, minimal 16 karakter. Buat dengan: openssl rand -hex 32
FOUNDATION_POSTGRES_PASSWORD=

# Opsional. Hapus tanda pagar untuk mengganti nilai default.
# FOUNDATION_POSTGRES_PORT=5432
# FOUNDATION_POSTGRES_IMAGE=foundation-postgres:18-dev
# Kosong berarti oraclelinux:10-slim dan paket PostgreSQL 18 terbaru dari PGDG.
# Test dan CI mengisinya dari infrastructure/postgres/pins.json.
# FOUNDATION_POSTGRES_BASE_IMAGE=oraclelinux:10-slim
# FOUNDATION_POSTGRES_PACKAGE_VERSION=
