{
  "name": "ojiepermana/foundation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": "1.4.2"
  },
  "scripts": {
    "ng": "ng",
    "dev": "bun scripts/dev.ts",
    "dev:web": "ng serve web --port 8088 --host localhost",
    "dev:api": "bun --watch apps/api/main.ts",
    "dev:worker": "bun --watch apps/worker/main.ts",
    "start:api": "bun apps/api/main.ts",
    "start:worker": "bun apps/worker/main.ts",
    "build": "ng build web",
    "typecheck": "tsc --noEmit -p tsconfig.server.json && ng build web --configuration development",
    "typecheck:server": "tsc --noEmit -p tsconfig.server.json",
    "test": "bun test tests/unit",
    "test:integration": "bun test --timeout 30000 tests/integration",
    "test:web": "ng test web --watch=false",
    "test:e2e": "playwright test",
    "check:structure": "bun scripts/check-structure.ts",
    "db:migrate": "bun scripts/migrate.ts",
    "db:status": "bun scripts/migrate.ts --status",
    "user:register": "bun scripts/user-register.ts",
    "user:resend-activation": "bun scripts/user-register.ts --resend",
    "jobs:work": "bun apps/worker/main.ts",
    "jobs:failed": "bun scripts/jobs.ts failed",
    "jobs:retry": "bun scripts/jobs.ts retry",
    "cache:forget": "bun scripts/cache.ts forget",
    "cache:clear": "bun scripts/cache.ts clear",
    "check": "bun run check:structure && bun run typecheck:server && bun test tests/unit && bun run build"
  },
  "dependencies": {
    "@angular/cdk": "^22.1.6",
    "@angular/common": "^22.1.6",
    "@angular/compiler": "^22.1.6",
    "@angular/core": "^22.1.6",
    "@angular/forms": "^22.1.6",
    "@angular/material": "^22.1.6",
    "@angular/platform-browser": "^22.1.6",
    "@angular/router": "^22.1.6",
    "@ojiepermana/angular": "^22.1.13",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.2",
    "elysia": "^1.4.30",
    "nodemailer": "^10.0.10",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.6",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "^1.4.2",
    "@types/nodemailer": "^8.0.2",
    "@types/smtp-server": "^3.5.13",
    "jsdom": "^30.0.1",
    "prettier": "^3.8.1",
    "smtp-server": "^3.19.13",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
